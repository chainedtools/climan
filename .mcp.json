{
  "mcpServers": {
    "openrouter-docs": {
     "url": "https://openrouter.ai/docs/mcp"
    },
    "browserbase": {
      "type": "http",
      "url": "https://mcp.browserbase.com/mcp",
      "headers": {
        "x-bb-api-key": "${BROWSERBASE_API_KEY}"
      }
    },
    "exa": {
    "url": "https://mcp.exa.ai/mcp",
    "headers": {
      "x-api-key": "${EXA_API_KEY}"
    }
  },
    "firecrawl": {
      "command": "bunx",
      "args": "firecrawl-mcp"
    },
    "kernel": {
      "type": "stdio",
      "command": "bunx",
      "args": ["mcp-remote", "https://mcp.onkernel.com/mcp"]
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "mintlify-docs": {
      "type": "http",
      "url": "https://mintlify.com/docs/mcp"
    },
    "deepl-developer-docs": {
      "type": "http",
      "url": "https://developers.deepl.com/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "solved-docs": {
      "url": "https://docs.solved.gg/mcp"
    },
    "1password": {
      "command": "bunx",
      "args": ["@takescake/1password-mcp"],
      "env": {
        "OP_SERVICE_ACCOUNT_TOKEN": "${OP_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp",
      "headers": {
        "Authorization": "Sentry-Bearer ${SENTRY_ACCESS_TOKEN}"
      }
    },
    "zig-docs": {
      "command": "bunx",
      "args": ["zig-mcp@latest"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
        "nixos": {
          "command": "uvx",
          "args": ["mcp-nixos"],
          "lifecycle": "lazy"
        }
  }
}
